<?xml version="1.0" encoding="utf-8"?>
<!--
  Without this file, restore inherits whatever sources a machine happens to have
  configured, so a contributor with an extra feed resolves a different graph than
  CI does. `clear` drops the inherited sources and pins restore to nuget.org.

  The mapping is `*` to one source today, which is the trivial case. It is here so
  that adding a second feed later cannot silently widen where an existing package
  may come from — the point at which a public package can shadow a private one.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
