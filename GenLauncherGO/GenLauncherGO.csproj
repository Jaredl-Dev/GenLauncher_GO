<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>GenLauncherGO</AssemblyName>
    <RootNamespace>GenLauncherGO</RootNamespace>
    <StartupObject>GenLauncherGO.Features.Startup.EntryPoint</StartupObject>
    <ApplicationIcon>Shared\Resources\Icons\GenLauncherGo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <VersionPrefix>1.1.1</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>GenLauncherGO</Authors>
    <Company>GenLauncherGO</Company>
    <Product>GenLauncherGO</Product>
    <Description>Command &amp; Conquer: Generals and Zero Hour mod management utility and launcher for SuperHackers and GeneralsOnline community clients</Description>
    <VelopackUpdateRepositoryUrl>https://github.com/Jaredl-Dev/GenLauncher_GO</VelopackUpdateRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="VelopackUpdateRepositoryUrl" Value="$(VelopackUpdateRepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="Minio"/>
    <PackageReference Include="Serilog"/>
    <PackageReference Include="Serilog.Extensions.Logging"/>
    <PackageReference Include="Serilog.Sinks.File"/>
    <PackageReference Include="SharpCompress"/>
    <PackageReference Include="YamlDotNet"/>
    <PackageReference Include="Avalonia"/>
    <PackageReference Include="Avalonia.Desktop"/>
    <PackageReference Include="Avalonia.Themes.Fluent"/>
    <PackageReference Include="CommunityToolkit.Mvvm"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Shared\Resources\Images\**"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Features\Mods\Resources\UserAddedModBannerGenerals.jpg" LogicalName="GenLauncherGO.Features.Mods.Resources.UserAddedModBannerGenerals.jpg"/>
    <EmbeddedResource Include="Features\Mods\Resources\UserAddedModBannerZeroHour.jpg" LogicalName="GenLauncherGO.Features.Mods.Resources.UserAddedModBannerZeroHour.jpg"/>
  </ItemGroup>
</Project>
