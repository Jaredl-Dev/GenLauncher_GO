<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GenLauncherGO.UI.Shared.Controls"
        xmlns:localization="using:GenLauncherGO.UI.Shared.Localization"
        xmlns:launcherModels="using:GenLauncherGO.UI.Features.Launcher.Models"
        xmlns:launcherViews="using:GenLauncherGO.UI.Features.Launcher.Views"
        xmlns:mods="using:GenLauncherGO.UI.Features.Mods"
        xmlns:viewModels="using:GenLauncherGO.UI.Features.Launcher.ViewModels"
        x:Class="GenLauncherGO.UI.Features.Launcher.Views.MainWindow"
        x:ClassModifier="internal"
        x:DataType="viewModels:MainWindowViewModel"
        Width="970"
        Height="723"
        CanMaximize="False"
        WindowDecorations="Full"
        Title="{Binding WindowTitle}">

    <Window.DataTemplates>
        <DataTemplate DataType="launcherModels:ExecutableOption"
                      x:DataType="launcherModels:ExecutableOption">
            <StackPanel>
                <Border Classes="executable-group-header"
                        Classes.group-start="{Binding ShowGroupHeader}"
                        Margin="0,5,0,2"
                        Padding="9,4"
                        Background="{DynamicResource GenLauncherLightBackGround}"
                        BorderBrush="{DynamicResource GenLauncherInactiveBorder}"
                        BorderThickness="0,0,0,1">
                    <TextBlock FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource GenLauncherInactiveBorder}"
                               Text="{Binding GroupDisplayName}" />
                </Border>
                <Border Classes="executable-option-row"
                        Margin="3,1"
                        Padding="9,5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding DisplayName}" />
                        <TextBlock Grid.Column="1"
                                   Classes="missing-executable-indicator"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource GenLauncherErrorColor}"
                                   FontWeight="Bold"
                                   Text="&#x2715;"
                                   ToolTip.Tip="{localization:Loc ExecutableUnavailable}"
                                   IsVisible="{Binding IsUnavailable}" />
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <LinearGradientBrush x:Key="DragAndDropBackground"
                             StartPoint="0%,50%"
                             EndPoint="100%,50%">
            <GradientStop Color="#E6191D25" Offset="0" />
            <GradientStop Color="{DynamicResource GenLauncherListBoxSelectionColor2}" Offset="0.5" />
            <GradientStop Color="#E6191D25" Offset="1" />
        </LinearGradientBrush>
        <StreamGeometry x:Key="DragMoveIconGeometry">
            M12,1 L8,5 L11,5 L11,9 L7,9 L7,6 L3,10 L7,14 L7,11 L11,11 L11,15 L8,15 L12,19 L16,15
            L13,15 L13,11 L17,11 L17,14 L21,10 L17,6 L17,9 L13,9 L13,5 L16,5 Z
        </StreamGeometry>

        <!-- Colours come from the shared ProgressBar style; this theme restores the launcher's full-height fill. -->
        <ControlTheme x:Key="LauncherProgressBarTheme"
                      TargetType="ProgressBar">
            <Setter Property="Template">
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:horizontal /template/ Border#PART_Indicator">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
            <Style Selector="^:vertical /template/ Border#PART_Indicator">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="LauncherListBoxItemTheme"
                      TargetType="ListBoxItem"
                      x:DataType="mods:ModificationViewModel">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherInactiveBorder}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Margin" Value="2,2,20,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Padding" Value="9,0,0,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="TileItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource ListBoxSelectedItemBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="GameClientComboBoxItemTheme"
                      TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
                <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
                <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
            </Style>
            <Style Selector="^:selected:pointerover">
                <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
                <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="TileVersionComboBoxItemTheme"
                      TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="TileVersionItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource GenLauncherInactiveBorder2}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource GenLauncherInactiveBorder2}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource GenLauncherDisabledTextColor}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="TileVersionSelectorTheme"
                      TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource GenLauncherDarkFillColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ItemContainerTheme"
                    Value="{StaticResource TileVersionComboBoxItemTheme}" />
            <Setter Property="MaxDropDownHeight" Value="504" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid x:Name="TileVersionSelectorRoot"
                          ColumnDefinitions="*,20">
                        <!-- Keep the fill behind the selected item; the outline is painted above the content below. -->
                        <Border x:Name="Background"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0" />
                        <!-- Only the divider before the drop-down glyph. -->
                        <Border x:Name="TileVersionTextBoxBorder"
                                Grid.Column="0"
                                Margin="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,1,0"
                                CornerRadius="0" />
                        <ContentControl x:Name="ContentPresenter"
                                        Grid.Column="0"
                                        Margin="3"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        IsHitTestVisible="False" />
                        <Path x:Name="TileVersionDropDownGlyph"
                              Grid.Column="1"
                              Width="8"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z"
                              Fill="{TemplateBinding BorderBrush}"
                              IsHitTestVisible="False"
                              Stretch="None" />
                        <!-- Paint the outline last so selected-item content cannot cover any edge. -->
                        <Border x:Name="TileVersionSelectorOutline"
                                Grid.ColumnSpan="2"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                IsHitTestVisible="False"
                                RenderOptions.EdgeMode="Aliased" />
                        <Popup x:Name="PART_Popup"
                               WindowManagerAddShadowHint="False"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                               MaxHeight="{TemplateBinding MaxDropDownHeight}"
                               PlacementTarget="Background"
                               IsLightDismissEnabled="True"
                               InheritsTransform="True">
                            <Border x:Name="TileVersionPopupBorder"
                                    Margin="0,2,0,0"
                                    Background="{DynamicResource GenLauncherDarkFillColor}"
                                    BorderBrush="{DynamicResource GenLauncherBorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="0">
                                <ScrollViewer Margin="4,6"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ItemsPresenter x:Name="PART_ItemsPresenter"
                                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherInactiveBorder2}" />
                <Setter Property="Foreground" Value="{DynamicResource GenLauncherDisabledTextColor}" />
            </Style>
            <Style Selector="^:disabled /template/ Path#TileVersionDropDownGlyph">
                <Setter Property="Fill" Value="{DynamicResource GenLauncherDisabledTextColor}" />
            </Style>
        </ControlTheme>

        <DataTemplate x:Key="VersionTemplate"
                      x:DataType="mods:ModificationVersionSelection">
            <Grid ColumnDefinitions="140,*">
                <TextBlock Grid.Column="0"
                           Width="135"
                           Margin="5,0,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding VersionName}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Width="60"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Content="{localization:Loc Delete}"
                        Click="DeleteVersion_ClickAsync" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ModificationTemplate"
                      x:DataType="mods:ModificationViewModel">
            <Grid x:Name="LauncherContentTileRoot"
                  Width="550"
                  Classes="tile-root"
                  Classes.compact="{Binding UsesCompactTileLayout}"
                  RowDefinitions="26,26,Auto,Auto,34,40"
                  ColumnDefinitions="310,*,*,40"
                  Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu Classes="tile-context-menu"
                                 Theme="{StaticResource GenLauncherContextMenuTheme}"
                                 ItemContainerTheme="{StaticResource GenLauncherMenuItemTheme}"
                                 x:DataType="mods:ModificationViewModel"
                                 Opened="TileContextMenu_Opened">
                        <MenuItem Header="{localization:Loc SetImage}"
                                  FontSize="16"
                                  IsVisible="{Binding CanSetImage}"
                                  Click="ChangeVersionImage_ClickAsync" />
                        <Separator IsVisible="{Binding CanSetImage}" />
                        <MenuItem Header="{localization:Loc ModDb}"
                                  FontSize="18"
                                  IsVisible="{Binding CanOpenModDb}"
                                  Tag="{x:Static launcherModels:LauncherTileLinkKind.ModDb}"
                                  Click="OpenTileLink_ClickAsync" />
                        <MenuItem Header="{localization:Loc Discord}"
                                  FontSize="18"
                                  IsVisible="{Binding CanOpenDiscord}"
                                  Tag="{x:Static launcherModels:LauncherTileLinkKind.Discord}"
                                  Click="OpenTileLink_ClickAsync" />
                    </ContextMenu>
                </Grid.ContextMenu>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Classes="tile-name"
                           Classes.selected="{Binding IsSelected}"
                           Margin="10,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="{Binding NameInfo}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Classes="tile-version"
                           Classes.selected="{Binding IsSelected}"
                           Margin="10,0,10,4"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Text="{Binding LatestVersionInfo}"
                           TextTrimming="CharacterEllipsis" />

                <Grid Grid.Row="0"
                      Grid.RowSpan="2"
                      Grid.Column="1"
                      Grid.ColumnSpan="3"
                      Height="30"
                      Margin="0,5,5,0"
                      VerticalAlignment="Top"
                      IsVisible="{Binding IsSelected}">
                    <ComboBox x:Name="LauncherContentVersionSelector"
                              Classes="tile-version-selector"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ItemsSource="{Binding VersionOptions}"
                              SelectedItem="{Binding SelectedVersionOption, Mode=TwoWay}"
                              ItemTemplate="{StaticResource VersionTemplate}"
                              IsEnabled="{Binding IsVersionSelectorEnabled}"
                              IsVisible="{Binding IsVersionSelectorVisible}"
                              SelectionChanged="VersionsList_SelectionChangedAsync" />
                    <Button x:Name="LauncherContentVersionActionButton"
                            FontSize="13"
                            Content="{Binding VersionActionContent}"
                            IsVisible="{Binding IsVersionActionVisible}"
                            Click="DeleteModification_ClickAsync" />
                </Grid>

                <Grid x:Name="ModificationArtwork"
                      Grid.ColumnSpan="4"
                      Grid.Row="2"
                      Grid.RowSpan="2"
                      Classes="tile-artwork">
                    <Border x:Name="ModificationImageBorder"
                            Classes="tile-image-border"
                            Classes.selected="{Binding IsSelected}"
                            Margin="23,-2"
                            BorderThickness="{Binding ImageBorderThickness}"
                            IsVisible="{Binding HasImage}" />
                    <Image x:Name="ModificationInactiveImage"
                           Width="500"
                           Height="100"
                           Source="{Binding ImageSource}"
                           Stretch="Fill" />
                    <Image x:Name="ModificationSelectedImage"
                           Width="500"
                           Height="100"
                           Source="{Binding SelectedImageSource}"
                           Stretch="Fill"
                           IsVisible="{Binding IsSelected}" />
                </Grid>

                <Grid Grid.ColumnSpan="4"
                      Grid.Row="4"
                      Classes="tile-progress-row">
                    <ProgressBar x:Name="ModificationProgressBar"
                                 Classes="package-progress"
                                 Height="20"
                                 Margin="10,0"
                                 VerticalAlignment="Center"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 Foreground="{Binding ProgressForeground}"
                                 Background="{Binding ProgressBackground}"
                                 BorderBrush="{Binding ProgressBorderBrush}" />
                    <!-- Sized to keep a full download line (size, rate and ETA) inside the bar without truncating. -->
                    <TextBlock Classes="tile-progress-message"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{Binding ProgressTextForeground}"
                               Text="{Binding ProgressMessage}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid x:Name="ModificationButtonRow"
                      Grid.Row="5"
                      Classes="tile-full-actions"
                      Grid.ColumnSpan="4"
                      Height="30"
                      Margin="10,6,10,0"
                      VerticalAlignment="Top"
                      ColumnDefinitions="140,*,100,*,150,*,90">
                    <controls:UpdateButton x:Name="ModificationUpdateButton"
                                           Grid.Column="0"
                                           Width="140"
                                           Height="30"
                                           Margin="0"
                                           Padding="1"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           FontSize="15"
                                           Content="{Binding UpdateButtonContent}"
                                           IsEnabled="{Binding UpdateButtonEnabled}"
                                           IsBlinking="{Binding UpdateButtonBlinking}"
                                           IsVisible="{Binding IsUpdateButtonVisible}"
                                           Click="UpdateModification_ClickAsync" />
                    <Grid x:Name="ModificationSecondaryActions"
                          Grid.ColumnSpan="7"
                          ColumnDefinitions="140,*,100,*,150,*,90"
                          IsVisible="{Binding IsSelectedOrAdvertising}">
                        <controls:UpdateButton x:Name="ModificationSupportButton"
                                               Grid.Column="2"
                                               Width="100"
                                               Height="30"
                                               Margin="0"
                                               Padding="1"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               FontSize="14"
                                               Content="{Binding SupportButtonContent}"
                                               IsBlinking="{Binding SupportButtonBlinking}"
                                               IsVisible="{Binding IsSupportButtonVisible}"
                                               Tag="{x:Static launcherModels:LauncherTileLinkKind.Support}"
                                               Click="OpenTileLink_ClickAsync" />
                        <Button x:Name="ModificationNetworkInfoButton"
                                Grid.Column="4"
                                Width="150"
                                Height="30"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                FontSize="14"
                                Content="{Binding NetworkInfoButtonContent}"
                                IsVisible="{Binding IsNetworkInfoVisible}"
                                Tag="{x:Static launcherModels:LauncherTileLinkKind.NetworkInfo}"
                                Click="OpenTileLink_ClickAsync" />
                        <Button x:Name="ModificationChangeLogButton"
                                Grid.Column="6"
                                Width="90"
                                Height="30"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                FontSize="14"
                                Content="{Binding ChangeLogButtonContent}"
                                IsVisible="{Binding IsChangeLogVisible}"
                                Tag="{x:Static launcherModels:LauncherTileLinkKind.ChangeLog}"
                                Click="OpenTileLink_ClickAsync" />
                    </Grid>
                </Grid>

                <Grid Classes="tile-compact-actions"
                      Grid.Row="5"
                      Grid.ColumnSpan="4">
                    <controls:UpdateButton x:Name="CompactUpdateButton"
                                           Width="140"
                                           Height="30"
                                           Margin="10,6,10,0"
                                           Padding="1"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           FontSize="18"
                                           Content="{Binding UpdateButtonContent}"
                                           IsEnabled="{Binding UpdateButtonEnabled}"
                                           IsBlinking="{Binding UpdateButtonBlinking}"
                                           IsVisible="{Binding IsUpdateButtonVisible}"
                                           Click="UpdateModification_ClickAsync" />
                    <Grid x:Name="CompactSecondaryActions"
                          Grid.ColumnSpan="4"
                          IsVisible="{Binding IsSelected}">
                        <Button x:Name="CompactNetworkInfoButton"
                                Width="150"
                                Height="30"
                                Margin="0,6,-40,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Content="{Binding NetworkInfoButtonContent}"
                                IsVisible="{Binding IsNetworkInfoVisible}"
                                Tag="{x:Static launcherModels:LauncherTileLinkKind.NetworkInfo}"
                                Click="OpenTileLink_ClickAsync" />
                        <Button x:Name="CompactChangeLogButton"
                                Width="140"
                                Height="30"
                                Margin="5,6,5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Content="{Binding ChangeLogButtonContent}"
                                IsVisible="{Binding IsChangeLogVisible}"
                                Tag="{x:Static launcherModels:LauncherTileLinkKind.ChangeLog}"
                                Click="OpenTileLink_ClickAsync" />
                    </Grid>
                </Grid>

                <Grid x:Name="ModificationDragOverlayHost"
                      Grid.RowSpan="6"
                      Grid.ColumnSpan="4"
                      Classes="tile-drag-overlay-host"
                      IsHitTestVisible="False">
                    <Border x:Name="ModificationDragOverlay"
                            Margin="-6,0"
                            Background="{StaticResource DragAndDropBackground}"
                            BorderBrush="{DynamicResource GenLauncherActiveColor}"
                            BorderThickness="2"
                            CornerRadius="5"
                            IsVisible="{Binding IsDragAndDropVisible}">
                        <Border Width="52"
                                Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#E61A1F28"
                                BorderBrush="{DynamicResource GenLauncherActiveColor}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <Viewbox Width="22" Height="22">
                                <Path Data="{StaticResource DragMoveIconGeometry}"
                                      Fill="{DynamicResource GenLauncherActiveColor}"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
        </Style>
        <Style Selector="Border.executable-group-header">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.executable-option-row">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem Border.executable-group-header.group-start">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover Border.executable-option-row">
            <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
        </Style>
        <Style Selector="ComboBoxItem:selected Border.executable-option-row">
            <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover Border.executable-option-row">
            <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover Border.executable-option-row TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
        </Style>
        <Style Selector="ListBox.launcher-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
        </Style>
        <Style
            Selector="ListBox.launcher-list ScrollBar:vertical /template/ RepeatButton#PART_LineUpButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style
            Selector="ListBox.launcher-list ScrollBar:vertical /template/ RepeatButton#PART_LineDownButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TextBlock.tile-name">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherInactiveBorder}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TextBlock.tile-name.selected">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.tile-version">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherInactiveBorder}" />
        </Style>
        <Style Selector="TextBlock.tile-version.selected">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
        </Style>
        <Style Selector="Grid.tile-root.compact TextBlock.tile-name">
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Grid.tile-root.compact Grid.tile-artwork">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.tile-progress-message">
            <Setter Property="Margin" Value="25,0,40,0" />
        </Style>
        <Style Selector="Grid.tile-root.compact TextBlock.tile-progress-message">
            <Setter Property="Margin" Value="40,0" />
        </Style>
        <Style Selector="Grid.tile-compact-actions">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.tile-root.compact Grid.tile-full-actions">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.tile-root.compact Grid.tile-compact-actions">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Grid.tile-root.compact Grid.tile-drag-overlay-host">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.tile-image-border">
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherInactiveBorder}" />
        </Style>
        <Style Selector="Border.tile-image-border.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherActiveColor}" />
        </Style>
        <Style Selector="ComboBox.tile-version-selector">
            <Setter Property="Height" Value="30" />
            <Setter Property="Theme" Value="{StaticResource TileVersionSelectorTheme}" />
        </Style>
        <Style Selector="ComboBox.game-client-selector">
            <Setter Property="Background" Value="{DynamicResource GenLauncherLightBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,0,28,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:pointerover">
            <Setter Property="Background" Value="{DynamicResource GenLauncherLightBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
        </Style>
        <Style Selector="ComboBox.game-client-selector /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource GenLauncherLightBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource GenLauncherLightBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource GenLauncherLightBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:dropdownopen /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource GenLauncherLightBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:disabled /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherInactiveBorder2}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:focus-visible /template/ Border#HighlightBackground">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ComboBox.game-client-selector /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:pointerover /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:disabled /template/ ContentControl#ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
        </Style>
        <Style Selector="ComboBox.game-client-selector /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:pointerover /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:disabled /template/ PathIcon#DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
        </Style>
        <Style Selector="ComboBox.game-client-selector:dropdownopen /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ContextMenu.tile-context-menu MenuItem">
            <Setter Property="MinWidth" Value="300" />
        </Style>
        <Style Selector="ContextMenu.tile-context-menu Separator">
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Background" Value="{DynamicResource GenLauncherBorderColor}" />
        </Style>
        <Style Selector="ProgressBar.package-progress">
            <Setter Property="Theme" Value="{StaticResource LauncherProgressBarTheme}" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="18" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="Button.tab-button">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- The blanket TextBlock rule above would otherwise force these labels to plain body text. -->
        <Style Selector="Button.tab-button TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherActionTextColor}" />
        </Style>
        <Style Selector="Button.tab-button:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherActiveColor}" />
        </Style>
        <Style Selector="Button.tab-button:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherInactiveBorder}" />
        </Style>
        <Style Selector="Button.sidebar-button">
            <Setter Property="Width" Value="229" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="17" />
        </Style>
    </Window.Styles>

    <!--
      The frame, panels and wordmark are painted into the background image, so the image and the control
      tree must scale as one unit or the controls drift out of their painted boxes. The Viewbox stretches
      the fixed 970x723 legacy client viewport to whatever size the window is, matching the Stretch=Fill
      the artwork itself uses; both distort together, so the controls never leave their painted boxes.
    -->
    <Viewbox Stretch="Fill">
        <Panel Width="970"
               Height="723"
               Background="{DynamicResource GenLauncherBackGroundImage}">
            <Grid x:Name="MainLayoutGrid"
                  RowDefinitions="50,35,40,*,0.32*,50"
                  ColumnDefinitions="41,70*,66*,206*,273*,13,259*,52">
                <ListBox x:Name="ModsList"
                         Grid.Row="3"
                         Grid.RowSpan="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="4"
                         Classes="launcher-list"
                         Margin="12,0,10,40"
                         ItemContainerTheme="{StaticResource LauncherListBoxItemTheme}"
                         ItemsSource="{Binding ModsListSource}"
                         ItemTemplate="{StaticResource ModificationTemplate}"
                         IsEnabled="{Binding MainControlsEnabled}"
                         SelectionMode="Single"
                         SelectionChanged="ModsList_SelectionChangedAsync" />

                <ListBox x:Name="PatchesList"
                         Grid.Row="3"
                         Grid.RowSpan="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="4"
                         Classes="launcher-list"
                         Margin="12,0,10,40"
                         ItemContainerTheme="{StaticResource LauncherListBoxItemTheme}"
                         ItemsSource="{Binding PatchesListSource}"
                         ItemTemplate="{StaticResource ModificationTemplate}"
                         IsEnabled="{Binding MainControlsEnabled}"
                         SelectionMode="Single"
                         SelectionChanged="ChildContentList_SelectionChangedAsync" />

                <launcherViews:LauncherContentListBox x:Name="AddonsList"
                                                      Grid.Row="3"
                                                      Grid.RowSpan="2"
                                                      Grid.Column="1"
                                                      Grid.ColumnSpan="4"
                                                      Classes="launcher-list"
                                                      Margin="12,0,10,40"
                                                      ItemContainerTheme="{StaticResource LauncherListBoxItemTheme}"
                                                      ItemsSource="{Binding AddonsListSource}"
                                                      ItemTemplate="{StaticResource ModificationTemplate}"
                                                      IsEnabled="{Binding MainControlsEnabled}"
                                                      SelectionMode="Multiple, Toggle"
                                                      SelectionChanged="ChildContentList_SelectionChangedAsync" />

                <Button x:Name="StartGameButton"
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Grid.Column="6"
                        Classes="sidebar-button"
                        Margin="25,14,0,0"
                        Content="{localization:Loc Launch}"
                        IsEnabled="{Binding StartGameButtonEnabled}"
                        Click="LaunchGame_ClickAsync" />
                <Button x:Name="WorldBuilderButton"
                        Grid.Row="3"
                        Grid.Column="6"
                        Classes="sidebar-button"
                        Margin="25,19,0,0"
                        Content="{localization:Loc WorldBuilder}"
                        IsEnabled="{Binding WorldBuilderButtonEnabled}"
                        Click="LaunchWorldBuilder_ClickAsync" />
                <Button x:Name="WindowedButton"
                        Grid.Row="3"
                        Grid.Column="6"
                        Classes="sidebar-button"
                        Margin="25,64,0,0"
                        Content="{Binding WindowedModeButtonText}"
                        IsEnabled="{Binding MainControlsEnabled}"
                        Click="ToggleWindowedMode_ClickAsync" />
                <Button x:Name="QuickStartButton"
                        Grid.Row="3"
                        Grid.Column="6"
                        Classes="sidebar-button"
                        Margin="25,109,0,0"
                        Content="{Binding QuickStartButtonText}"
                        IsEnabled="{Binding MainControlsEnabled}"
                        Click="ToggleQuickStart_ClickAsync" />
                <Button x:Name="OptionsButton"
                        Grid.Row="3"
                        Grid.Column="6"
                        Classes="sidebar-button"
                        Margin="25,154,0,0"
                        Content="{localization:Loc Options}"
                        IsEnabled="{Binding MainControlsEnabled}"
                        Click="OpenOptions_ClickAsync" />
                <Button x:Name="ExitButton"
                        Grid.Row="3"
                        Grid.Column="6"
                        Classes="sidebar-button"
                        Margin="25,211,0,0"
                        Content="{localization:Loc Exit}"
                        Click="Close_Click" />

                <TextBlock x:Name="GameClientSelectorLabel"
                           Grid.Row="4"
                           Grid.Column="6"
                           Width="229"
                           Height="22"
                           Margin="25,10,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           FontSize="14"
                           Text="{localization:Loc SelectedGameClient}"
                           TextWrapping="Wrap" />
                <ComboBox x:Name="GameClientSelector"
                          Grid.Row="4"
                          Grid.Column="6"
                          Width="229"
                          Height="31"
                          Margin="25,32,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Classes="game-client-selector"
                          ItemContainerTheme="{StaticResource GameClientComboBoxItemTheme}"
                          ItemsSource="{Binding SupportedGameClients}"
                          SelectedItem="{Binding SelectedGameClientOption, Mode=TwoWay}"
                          IsEnabled="{Binding GameClientSelectorEnabled}"
                          ToolTip.ShowOnDisabled="True">
                    <ToolTip.Tip>
                        <TextBlock MaxWidth="420"
                                   Foreground="{DynamicResource GenLauncherDefaultTextColor}"
                                   Text="{Binding SelectedGameClientOption.ExecutableName}"
                                   TextWrapping="Wrap" />
                    </ToolTip.Tip>
                </ComboBox>
                <TextBlock x:Name="WorldBuilderSelectorLabel"
                           Grid.Row="4"
                           Grid.Column="6"
                           Width="229"
                           Height="22"
                           Margin="25,65,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           FontSize="14"
                           Text="{localization:Loc SelectedWorldBuilder}"
                           TextWrapping="Wrap" />
                <ComboBox x:Name="WorldBuilderSelector"
                          Grid.Row="4"
                          Grid.Column="6"
                          Width="229"
                          Height="31"
                          Margin="25,87,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Classes="game-client-selector"
                          ItemContainerTheme="{StaticResource GameClientComboBoxItemTheme}"
                          ItemsSource="{Binding SupportedWorldBuilders}"
                          SelectedItem="{Binding SelectedWorldBuilderOption, Mode=TwoWay}"
                          IsEnabled="{Binding WorldBuilderSelectorEnabled}"
                          ToolTip.ShowOnDisabled="True">
                    <ToolTip.Tip>
                        <TextBlock MaxWidth="420"
                                   Foreground="{DynamicResource GenLauncherDefaultTextColor}"
                                   Text="{Binding SelectedWorldBuilderOption.ExecutableName}"
                                   TextWrapping="Wrap" />
                    </ToolTip.Tip>
                </ComboBox>

                <controls:LauncherLoadingIndicator x:Name="DownloadingImage"
                                                   Grid.RowSpan="6"
                                                   Grid.Column="4"
                                                   Width="180"
                                                   Margin="1,0,92,0"
                                                   HorizontalAlignment="Center"
                                                   IsVisible="{Binding IsLoadingIndicatorVisible}" />

                <Button x:Name="ModsButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="66"
                        Height="25"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontSize="14"
                        Content="{localization:Loc Mods}"
                        IsEnabled="{Binding MainControlsEnabled}"
                        Click="ShowModifications_ClickAsync" />
                <Button x:Name="PatchesButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Width="265"
                        Classes="tab-button"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsVisible="{Binding IsPatchesButtonVisible}"
                        IsEnabled="{Binding MainControlsEnabled}"
                        Click="ShowPatches_ClickAsync">
                    <Grid>
                        <TextBlock Margin="20,0,30,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding PatchesTabText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Viewbox Width="13"
                                 Height="13"
                                 Margin="0,0,9,0"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsPatchesTabDownloadIndicatorVisible}"
                                 ToolTip.Tip="{localization:Loc Downloading}">
                            <Path Data="M8,1 L8,10 M4,6 L8,10 L12,6 M3,13 L13,13"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource GenLauncherBorderColor}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        </Viewbox>
                    </Grid>
                </Button>
                <Button x:Name="AddonsButton"
                        Grid.Row="1"
                        Grid.Column="4"
                        Width="265"
                        Classes="tab-button"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsVisible="{Binding IsAddonsButtonVisible}"
                        IsEnabled="{Binding MainControlsEnabled}"
                        Click="ShowAddons_ClickAsync">
                    <Grid>
                        <TextBlock Margin="20,0,30,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding AddonsTabText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Viewbox Width="13"
                                 Height="13"
                                 Margin="0,0,9,0"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsAddonsTabDownloadIndicatorVisible}"
                                 ToolTip.Tip="{localization:Loc Downloading}">
                            <Path Data="M8,1 L8,10 M4,6 L8,10 L12,6 M3,13 L13,13"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource GenLauncherBorderColor}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        </Viewbox>
                    </Grid>
                </Button>

                <TextBlock x:Name="CurrentLauncherVersionText"
                           Grid.Row="4"
                           Grid.RowSpan="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="4"
                           Width="605"
                           Height="30"
                           Margin="2,82,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Text="{Binding CurrentLauncherVersionText}"
                           TextWrapping="Wrap" />

                <controls:UpdateButton x:Name="AddModButton"
                                       Grid.Row="2"
                                       Grid.Column="2"
                                       Grid.ColumnSpan="2"
                                       Width="160"
                                       Height="28"
                                       Margin="25,7,0,0"
                                       Padding="1"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Content="{localization:Loc AddMod}"
                                       IsEnabled="{Binding MainControlsEnabled}"
                                       IsVisible="{Binding IsAddModButtonVisible}"
                                       IsBlinking="{Binding AddModButtonBlinking}"
                                       Click="AddRepositoryModification_ClickAsync" />
                <Button x:Name="ManualAddMod"
                        Grid.Row="2"
                        Grid.Column="3"
                        Grid.ColumnSpan="2"
                        Width="240"
                        Height="28"
                        Margin="170,7,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontSize="16"
                        FontWeight="Bold"
                        Content="{localization:Loc AddModFromFiles}"
                        IsEnabled="{Binding MainControlsEnabled}"
                        Click="ImportManualModification_ClickAsync" />
                <Button x:Name="ManualAddPatch"
                        Grid.Row="2"
                        Grid.Column="3"
                        Grid.ColumnSpan="2"
                        Width="360"
                        Height="28"
                        Margin="1,7,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontSize="13"
                        FontWeight="Bold"
                        Content="{Binding ManualAddPatchText}"
                        IsEnabled="{Binding MainControlsEnabled}"
                        Click="ImportManualPatch_ClickAsync" />
                <Button x:Name="ManualAddAddon"
                        Grid.Row="2"
                        Grid.Column="3"
                        Grid.ColumnSpan="2"
                        Width="360"
                        Height="28"
                        Margin="1,7,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontSize="13"
                        FontWeight="Bold"
                        Content="{Binding ManualAddAddonText}"
                        IsEnabled="{Binding MainControlsEnabled}"
                        Click="ImportManualAddon_ClickAsync" />

                <Grid Grid.RowSpan="6"
                      Grid.ColumnSpan="8"
                      Panel.ZIndex="100"
                      Background="{DynamicResource GenLauncherScrimColor}"
                      Focusable="True"
                      IsHitTestVisible="True"
                      IsVisible="{Binding IsRunningProcessOverlayVisible}">
                    <Border Width="560"
                            MinHeight="230"
                            Padding="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource GenLauncherDarkBackGround}"
                            BorderBrush="{DynamicResource GenLauncherBorderColor}"
                            BorderThickness="2">
                        <Grid RowDefinitions="Auto,Auto,34,Auto">
                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,16"
                                       HorizontalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GenLauncherActiveColor}"
                                       Text="{localization:Loc RunningProcessOverlayTitle}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,0,0,20"
                                       HorizontalAlignment="Stretch"
                                       FontSize="18"
                                       Text="{Binding RunningProcessStatusText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <ProgressBar Grid.Row="2"
                                         Height="12"
                                         Margin="30,0,30,22"
                                         IsIndeterminate="True" />
                            <Button Grid.Row="3"
                                    MinWidth="260"
                                    MinHeight="46"
                                    Padding="18,4"
                                    HorizontalAlignment="Center"
                                    Click="ForceQuitRunningProcess_ClickAsync">
                                <TextBlock Text="{localization:Loc ForceQuitRunningProcess}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Canvas x:Name="DragLayer"
                    Width="970"
                    Height="723"
                    Panel.ZIndex="200"
                    IsHitTestVisible="False">
                <Border x:Name="ModificationDragPreview"
                        x:DataType="mods:ModificationViewModel"
                        Width="360"
                        MinHeight="72"
                        Padding="12,10"
                        Background="#F21A1F28"
                        BorderBrush="{DynamicResource GenLauncherActiveColor}"
                        BorderThickness="2"
                        BoxShadow="0 8 24 0 #A0000000"
                        CornerRadius="9"
                        IsVisible="False">
                    <Grid ColumnDefinitions="44,*">
                        <Border Width="36"
                                Height="36"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource GenLauncherDarkBackGround}"
                                BorderBrush="{DynamicResource GenLauncherBorderColor}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <Viewbox Width="20" Height="20">
                                <Path Data="{StaticResource DragMoveIconGeometry}"
                                      Fill="{DynamicResource GenLauncherActiveColor}"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource GenLauncherDefaultTextColor}"
                                       Text="{Binding NameInfo}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource GenLauncherInactiveBorder}"
                                       Text="{Binding LatestVersionInfo}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Canvas>
        </Panel>
    </Viewbox>
</Window>
