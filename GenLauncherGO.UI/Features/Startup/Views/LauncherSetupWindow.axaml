<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GenLauncherGO.UI.Shared.Controls"
        xmlns:localization="using:GenLauncherGO.UI.Shared.Localization"
        xmlns:vm="using:GenLauncherGO.UI.Features.Startup.ViewModels"
        x:Class="GenLauncherGO.UI.Features.Startup.Views.LauncherSetupWindow"
        x:ClassModifier="internal"
        x:Name="SetupWindowRoot"
        x:DataType="vm:LauncherSetupViewModel"
        Title="{localization:Loc GameInstallationSetupTitle}"
        Width="820"
        Height="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <MenuFlyout x:Key="InstallationPathContextFlyout"
                    ShowMode="{OnFormFactor Desktop=Standard, Mobile=Transient}"
                    FlyoutPresenterTheme="{StaticResource GenLauncherMenuFlyoutPresenterTheme}"
                    ItemContainerTheme="{StaticResource GenLauncherMenuItemTheme}">
            <MenuItem Header="{DynamicResource StringTextFlyoutCutText}"
                      Command="{Binding $parent[TextBox].Cut}"
                      IsEnabled="{Binding $parent[TextBox].CanCut}"
                      InputGesture="{x:Static TextBox.CutGesture}" />
            <MenuItem Header="{DynamicResource StringTextFlyoutCopyText}"
                      Command="{Binding $parent[TextBox].Copy}"
                      IsEnabled="{Binding $parent[TextBox].CanCopy}"
                      InputGesture="{x:Static TextBox.CopyGesture}" />
            <MenuItem Header="{DynamicResource StringTextFlyoutPasteText}"
                      Command="{Binding $parent[TextBox].Paste}"
                      IsEnabled="{Binding $parent[TextBox].CanPaste}"
                      InputGesture="{x:Static TextBox.PasteGesture}" />
        </MenuFlyout>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBox.installation-path">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="ContextFlyout" Value="{StaticResource InstallationPathContextFlyout}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- The path field keeps a hairline border in every state so the row height never shifts as it validates. -->
        <Style
            Selector="TextBox.installation-path /template/ Border#PART_BorderElement, TextBox.installation-path:pointerover /template/ Border#PART_BorderElement, TextBox.installation-path:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.installation-status">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.installation-status.valid">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.installation-status.invalid">
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherErrorColor}" />
        </Style>
        <Style Selector="TextBlock.installation-folder-label">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.notice">
            <Setter Property="Margin" Value="0,9,0,0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Border Classes="dialog-frame">
        <Grid RowDefinitions="56,*,66">
            <Border Classes="dialog-band header"
                    controls:LauncherWindowDragHandle.IsEnabled="{Binding #SetupWindowRoot.CanMoveWindow}">
                <TextBlock Classes="dialog-title"
                           Text="{localization:Loc GameInstallationSetupTitle}" />
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="22,18,10,18"
                          Padding="0,0,12,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <Border Classes="notice"
                            Margin="0"
                            Padding="14,10"
                            Background="{DynamicResource GenLauncherLightBackGround}"
                            BorderBrush="{DynamicResource GenLauncherActiveColor}"
                            BorderThickness="2">
                        <TextBlock Text="{localization:Loc GameFirstRunRegistryNotice}"
                                   Foreground="{DynamicResource GenLauncherActiveColor}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Installations.Games}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LauncherGameInstallationViewModel">
                                <Border Classes="dialog-panel">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="17"
                                                   FontWeight="Bold" />
                                        <TextBlock Classes="installation-status"
                                                   Classes.valid="{Binding IsValid}"
                                                   Classes.invalid="{Binding HasValidationError}"
                                                   Text="{Binding StatusText}" />
                                        <TextBlock Margin="0,13,0,5"
                                                   Classes="installation-folder-label"
                                                   Text="{localization:Loc InstallationFolder}" />
                                        <TextBox Classes="installation-path"
                                                 Text="{Binding Path, Mode=TwoWay}"
                                                 TextChanged="PathTextBox_TextChanged"
                                                 ToolTip.ToolTipOpening="PathTextBox_ToolTipOpening">
                                            <ToolTip.Tip>
                                                <TextBlock MaxWidth="700"
                                                           Text="{Binding Path}"
                                                           TextWrapping="Wrap" />
                                            </ToolTip.Tip>
                                        </TextBox>
                                        <StackPanel Margin="0,10,0,0"
                                                    Orientation="Horizontal"
                                                    Spacing="10">
                                            <Button Classes="dialog-action"
                                                    Content="{localization:Loc Browse}"
                                                    Command="{Binding BrowseCommand}"
                                                    CommandParameter="{Binding #SetupWindowRoot}" />
                                            <Button Classes="dialog-action"
                                                    MinWidth="176"
                                                    Content="{localization:Loc DetectViaRegistry}"
                                                    Command="{Binding DetectCommand}" />
                                        </StackPanel>
                                        <Border Classes="notice"
                                                Background="{DynamicResource GenLauncherLightBackGround}"
                                                BorderBrush="{DynamicResource GenLauncherActiveColor}"
                                                IsVisible="{Binding ShowProgramFilesWarning}">
                                            <TextBlock Text="{localization:Loc ProgramFilesModToolsWarning}"
                                                       Foreground="{DynamicResource GenLauncherActiveColor}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                        <Border Classes="notice"
                                                Background="{DynamicResource GenLauncherLightBackGround}"
                                                BorderBrush="{DynamicResource GenLauncherBorderColor}"
                                                IsVisible="{Binding ShowDifferentDriveRecommendation}">
                                            <TextBlock Text="{localization:Loc SameDriveRecommendation}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Classes="dialog-band footer">
                <Grid Margin="21,0"
                      ColumnDefinitions="*,Auto,12,Auto">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="5"
                                Height="5"
                                Margin="0,1,9,0"
                                Background="{DynamicResource GenLauncherBorderColor}" />
                        <TextBlock Text="{localization:Loc AtLeastOneInstallationRequired}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource GenLauncherDefaultTextColor}"
                                   FontSize="13" />
                    </StackPanel>
                    <Button x:Name="CancelActionButton"
                            Grid.Column="1"
                            Classes="dialog-action"
                            Width="112"
                            VerticalAlignment="Center"
                            Content="{localization:Loc Exit}"
                            Command="{Binding CancelCommand}"
                            IsCancel="True" />
                    <Button x:Name="PrimaryActionButton"
                            Grid.Column="3"
                            Classes="dialog-action primary"
                            Width="124"
                            VerticalAlignment="Center"
                            Content="{localization:Loc Continue}"
                            Command="{Binding ContinueCommand}"
                            IsEnabled="{Binding Installations.CanContinue}"
                            IsDefault="True" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
