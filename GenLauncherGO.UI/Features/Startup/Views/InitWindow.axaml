<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GenLauncherGO.UI.Shared.Controls"
        xmlns:localization="using:GenLauncherGO.UI.Shared.Localization"
        x:Class="GenLauncherGO.UI.Features.Startup.Views.InitWindow"
        x:ClassModifier="internal"
        Title="{localization:Loc Downloading}"
        Width="200"
        Height="200"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
    <controls:LauncherLoadingIndicator Margin="20" />
</Window>
