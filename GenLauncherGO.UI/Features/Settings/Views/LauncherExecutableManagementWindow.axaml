<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GenLauncherGO.UI.Shared.Controls"
        xmlns:launcherModels="using:GenLauncherGO.UI.Features.Launcher.Models"
        xmlns:localization="using:GenLauncherGO.UI.Shared.Localization"
        xmlns:vm="using:GenLauncherGO.UI.Features.Settings.ViewModels"
        x:Class="GenLauncherGO.UI.Features.Settings.Views.LauncherExecutableManagementWindow"
        x:ClassModifier="internal"
        x:DataType="vm:LauncherExecutableManagementViewModel"
        Title="{Binding WindowTitle}"
        Width="720"
        Height="610"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <ControlTheme x:Key="ExecutableManagerListBoxItemTheme"
                      TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:focus-visible">
                <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.row-edit">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.row-edit:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource GenLauncherDefaultTextColor}" />
        </Style>
        <Style Selector="Button.row-edit:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.executable-row">
            <Setter Property="Background" Value="{DynamicResource GenLauncherLightBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.executable-row">
            <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherDarkFillColor}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover Border.executable-row">
            <Setter Property="Background" Value="{DynamicResource GenLauncherDarkBackGround}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GenLauncherBorderColor}" />
        </Style>
    </Window.Styles>

    <Border Classes="dialog-frame"
            Margin="14">
        <Grid RowDefinitions="56,Auto,*,58">
            <Border Classes="dialog-band header"
                    controls:LauncherWindowDragHandle.IsEnabled="True">
                <TextBlock Classes="dialog-title"
                           Text="{Binding WindowTitle}" />
            </Border>

            <Grid Grid.Row="1"
                  Margin="18,16,18,8"
                  ColumnDefinitions="*,12,Auto">
                <TextBox x:Name="ExecutableSearchInput"
                         Grid.Column="0"
                         Classes="dialog-input"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="{localization:Loc SearchExecutables}" />
                <Button x:Name="AddExecutableButton"
                        Grid.Column="2"
                        Classes="dialog-action"
                        MinWidth="142"
                        Content="{localization:Loc AddExecutable}"
                        Click="Add_ClickAsync" />
            </Grid>

            <ListBox x:Name="ExecutableEntries"
                     Grid.Row="2"
                     Margin="18,4,18,14"
                     Background="Transparent"
                     BorderBrush="{DynamicResource GenLauncherDarkFillColor}"
                     BorderThickness="1"
                     ItemContainerTheme="{StaticResource ExecutableManagerListBoxItemTheme}"
                     ItemsSource="{Binding Entries}"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="launcherModels:ExecutableOption">
                        <Border Classes="executable-row"
                                Margin="0,0,0,6"
                                Padding="11,8"
                                Background="{DynamicResource GenLauncherLightBackGround}"
                                BorderBrush="{DynamicResource GenLauncherDarkFillColor}"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="25,*,Auto,Auto">
                                <TextBlock Classes="missing-executable-indicator"
                                           VerticalAlignment="Center"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource GenLauncherErrorColor}"
                                           Text="&#x2715;"
                                           ToolTip.Tip="{localization:Loc ExecutableUnavailable}"
                                           IsVisible="{Binding IsUnavailable}" />
                                <StackPanel Grid.Column="1"
                                            IsVisible="{Binding IsBuiltIn}">
                                    <TextBlock FontSize="15"
                                               FontWeight="Bold"
                                               Text="{Binding DisplayName}" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource GenLauncherInactiveBorder}"
                                               Text="{Binding ExecutableName}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="row-edit"
                                        Tag="{Binding}"
                                        ToolTip.Tip="{localization:Loc EditExecutable}"
                                        IsVisible="{Binding CanRemove}"
                                        Click="Edit_ClickAsync">
                                    <StackPanel>
                                        <TextBlock FontSize="15"
                                                   FontWeight="Bold"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource GenLauncherInactiveBorder}"
                                                   Text="{Binding ExecutableName}" />
                                    </StackPanel>
                                </Button>
                                <!-- The built-in marker carries each theme's bright accent so it stands out. -->
                                <Border Grid.Column="2"
                                        Margin="10,0"
                                        Padding="7,3"
                                        VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource GenLauncherBorderColor}"
                                        BorderThickness="1"
                                        IsVisible="{Binding IsBuiltIn}">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource GenLauncherBorderColor}"
                                               Text="{localization:Loc BuiltIn}" />
                                </Border>
                                <Button Grid.Column="3"
                                        Classes="dialog-action"
                                        VerticalAlignment="Center"
                                        Content="{localization:Loc Remove}"
                                        IsVisible="{Binding CanRemove}"
                                        Tag="{Binding}"
                                        Click="Remove_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3"
                    Classes="dialog-band footer">
                <Button Classes="dialog-action"
                        HorizontalAlignment="Right"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center"
                        Command="{Binding CloseCommand}"
                        Content="{localization:Loc Close}" />
            </Border>
        </Grid>
    </Border>
</Window>
